const shuffle = a => { a=a.slice(); for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; };
const permIndex = p => PERMS.findIndex(q=>q[0]===p[0]&&q[1]===p[1]&&q[2]===p[2]);
const ENC={sword:'S',shield:'D',med:'M'}, DEC={S:'sword',D:'shield',M:'med'};
const enc = p => p.map(x=>ENC[x]).join('');
const dec = s => { if(typeof s!=='string'||s.length!==3) return null; const a=[...s].map(c=>DEC[c]); if(a.includes(undefined)||new Set(a).size!==3) return null; return a; };
const decList = arr => { const out=[]; if(!Array.isArray(arr)) return out; for(const s of arr){ const p=dec(s); if(!p||out.length>=300) break; out.push(p); } return out; };
const num = (v,d) => (Number.isInteger(v)&&v>0&&v<1e6)?v:d;

/* ---------- game logic ---------- */
function slotFx(a,b,m){
  const fa=[], fb=[];
  if(a==='sword'){ if(b==='shield'){ fa.push({k:'dmg',v:3*m}); fb.push({k:'guard'}); } else fb.push({k:'dmg',v:5*m}); }
  if(b==='sword'){ if(a==='shield'){ fb.push({k:'dmg',v:3*m}); fa.push({k:'guard'}); } else fa.push({k:'dmg',v:5*m}); }
  if(a==='med') fa.push({k:'heal',v:2*m});
  if(b==='med') fb.push({k:'heal',v:2*m});
  return {fa,fb};
}
function resolve(pA,pB){
  const slots=[]; const dmg=[0,0], heal=[0,0];
  for(let i=0;i<3;i++){
    const {fa,fb}=slotFx(pA[i],pB[i],MULT[i]);
    fa.forEach(f=>{ if(f.k==='dmg')dmg[0]+=f.v; if(f.k==='heal')heal[0]+=f.v; });
    fb.forEach(f=>{ if(f.k==='dmg')dmg[1]+=f.v; if(f.k==='heal')heal[1]+=f.v; });
    slots.push({fa,fb});
  }
  return {slots,dmg,heal};
}
const applyLife = (life,heal,dmg) => Math.min(MAX, life+heal) - dmg;
function judge(L){
  const d0=L[0]<=0, d1=L[1]<=0;
  if(d0&&d1){ if(L[0]<L[1]) return 1; if(L[1]<L[0]) return 0; return null; }
  if(d0) return 1; if(d1) return 0; return undefined;
}
function replay(p0,p1){
  let life=[START,START], over; const phases=[];
  const n=Math.min(p0.length,p1.length);
  for(let i=0;i<n&&over===undefined;i++){
    const r=resolve(p0[i],p1[i]), before=life.slice();
    life=[applyLife(life[0],r.heal[0],r.dmg[0]), applyLife(life[1],r.heal[1],r.dmg[1])];
    over=judge(life);
    phases.push({result:r,before,after:life.slice(),picks:[p0[i],p1[i]],over});
  }
  return {phases,lives:life,over};
}

/* CPU */
function cpuPick(){
  if(S.cpuLevel==='easy') return shuffle(ORDER);
  const total=S.cpuMem.reduce((a,b)=>a+b,0);
  const ev=PERMS.map(c=>{
    let s=0;
    PERMS.forEach((p,i)=>{ const r=resolve(c,p); s+=S.cpuMem[i]/total*((r.heal[0]-r.dmg[0])-(r.heal[1]-r.dmg[1])); });
    return s;
  });
  const T=4, w=ev.map(v=>Math.exp(v/T)), sum=w.reduce((a,b)=>a+b,0);
  let r=Math.random()*sum;
  for(let i=0;i<w.length;i++){ r-=w[i]; if(r<=0) return PERMS[i].slice(); }
  return PERMS[w.length-1].slice();
}
function learn(p){ S.cpuMem=S.cpuMem.map(v=>v*0.75); const i=permIndex(p); if(i>=0) S.cpuMem[i]+=1; }

/* ---------- flow (cpu / local) ---------- */
function startGame(){
  S.life=[START,START]; S.prev=[START,START]; S.phase=1; S.picks=[null,null]; S.cur=0;
  S.result=null; S.over=undefined; S.cpuMem=[1,1,1,1,1,1];
  S.hist=[]; S.date=new Date(); S.resultDone=false;
  if(S.mode==='cpu') beginSet(0); else { S.screen='handoff'; render(); }
}
function beginSet(idx){
  S.cur=idx; S.board=[null,null,null]; S.sel=null;
  S.deadline=Date.now()+LIMIT; S.screen='set'; render();
  clearInterval(S.timer); S.timer=setInterval(tick,100);
}
function stopTimer(){ clearInterval(S.timer); S.timer=null; }
function tick(){
  if(S.screen!=='set'){ stopTimer(); return; }
  const left=Math.max(0,S.deadline-Date.now());
  const t=app.querySelector('.timer'); if(t){
    t.querySelector('i').style.width=(left/LIMIT*100)+'%';
    t.querySelector('.sec').textContent=Math.ceil(left/1000)+'秒';
    t.classList.toggle('low',left<=10000);
  }
  if(left<=0){ autoFill(); confirmSet(); }
}
function autoFill(){
  const rest=shuffle(ORDER.filter(x=>!S.board.includes(x)));
  S.board=S.board.map(x=>x||rest.pop());
}
function confirmSet(){
  if(S.board.includes(null)) return;
  stopTimer();
  if(S.mode==='online'){
    if(R.picks.length<S.phase){ R.picks.push(enc(S.board)); pushPresence(); }
    S.screen='wait'; render(); syncOnline(); return;
  }
  S.picks[S.cur]=S.board.slice();
  if(S.mode==='cpu'){ S.picks[1]=cpuPick(); learn(S.picks[0]); finishPhase(); }
  else if(S.cur===0){ S.cur=1; S.screen='handoff'; render(); }
  else finishPhase();
}
function finishPhase(){
  const r=resolve(S.picks[0],S.picks[1]);
  S.prev=S.life.slice();
  S.life=[applyLife(S.life[0],r.heal[0],r.dmg[0]), applyLife(S.life[1],r.heal[1],r.dmg[1])];
  S.result=r; S.over=judge(S.life);
  S.hist.push({picks:[S.picks[0].slice(),S.picks[1].slice()], after:S.life.slice()});
  if(S.over!==undefined){ if(S.over===null) S.score[2]++; else S.score[S.over]++; }
  S.resultDone=false; S.screen='result'; render(); animateResult();
}
function nextPhase(){
  S.phase++; S.picks=[null,null]; S.result=null;
  if(S.mode==='cpu') beginSet(0); else { S.cur=0; S.screen='handoff'; render(); }
}

/* ---------- online (PeerJS, P2P) ---------- */
const PEER_PREFIX='ktk-';
const genCode=()=>{ const A='abcdefghjkmnpqrstuvwxyz23456789'; let s=''; for(let i=0;i<4;i++) s+=A[Math.floor(Math.random()*A.length)]; return s; };
const myState = () => ({t:'state', seat:R.seat, game:R.game, picks:R.picks.slice()});
function pushPresence(){ if(R.conn&&R.conn.open){ try{ R.conn.send(myState()); }catch(e){} } }
function resetMatch(){
  R.picks=[]; R.ack=0; R.setPhase=0; R.syncedGame=0; R.scoredGame=0; R.opp=null;
  R.rematchOffered=false; R.waitingRematch=false; R.error='';
  clearInterval(R.autoNext); R.autoNext=null; clearInterval(R.hb); R.hb=null; clearTimeout(R.joinTimer); R.joinTimer=null;
}
function destroyPeer(){
  clearInterval(R.hb); R.hb=null; clearTimeout(R.joinTimer); R.joinTimer=null;
  if(R.conn){ try{ R.conn.close(); }catch(e){} R.conn=null; }
  if(R.peer){ try{ R.peer.destroy(); }catch(e){} R.peer=null; }
  R.connected=false;
}
function openOnline(){
  S.mode='online'; S.screen='online'; R.state='menu'; R.error='';
  if(!window.Peer){ R.error='通信ライブラリを読み込めませんでした。ページを再読み込みしてください。'; }
  render();
}
function peerErrorText(e){
  const t=e&&e.type;
  if(t==='peer-unavailable') return 'その部屋は見つかりません。コードを確認してください';
  if(t==='network'||t==='server-error'||t==='socket-error'||t==='socket-closed') return '通信サーバーにつながりません。電波状況を確認してもう一度お試しください';
  if(t==='browser-incompatible') return 'このブラウザはオンライン対戦に対応していません';
  return '接続に失敗しました'+(t?'（'+t+'）':'');
}
function keepAwake(){ try{ if(navigator.wakeLock&&!R.wake) navigator.wakeLock.request('screen').then(w=>{R.wake=w;}).catch(()=>{}); }catch(e){} }
function hostRoom(attempt){
  if(!window.Peer) return;
  attempt=attempt||0; keepAwake();
  destroyPeer(); resetMatch();
  R.state='creating'; R.error=''; render();
  const code=genCode();
  const peer=new Peer(PEER_PREFIX+code);
  R.peer=peer; R.code=code; R.seat=0; R.game=1;
  peer.on('open',()=>{ if(R.peer!==peer) return; R.state='hosting'; render(); });
  peer.on('connection',conn=>{
    if(R.peer!==peer) return;
    if(R.conn){ conn.on('open',()=>{ try{ conn.send({t:'full'}); setTimeout(()=>conn.close(),300); }catch(e){} }); return; }
    setupConn(conn);
  });
  peer.on('error',e=>{
    if(R.peer!==peer) return;
    if(e.type==='unavailable-id'&&attempt<4){ hostRoom(attempt+1); return; }
    if(R.state==='creating'||R.state==='hosting'){ destroyPeer(); R.state='menu'; R.error=peerErrorText(e); render(); }
  });
  peer.on('disconnected',()=>{ if(R.peer===peer&&!peer.destroyed){ try{ peer.reconnect(); }catch(err){} } });
}
function joinRoom(){
  if(!window.Peer) return;
  const code=(R.codeInput||'').toLowerCase().replace(/[^a-z0-9]/g,'');
  if(code.length!==4){ R.error='4文字のコードを入力してください'; render(); return; }
  destroyPeer(); resetMatch(); keepAwake();
  R.state='joining'; R.error=''; render();
  const peer=new Peer();
  R.peer=peer; R.code=code; R.seat=1; R.game=1;
  const fail=msg=>{ if(R.peer!==peer) return; destroyPeer(); R.state='menu'; R.error=msg; render(); };
  R.joinTimer=setTimeout(()=>{ if(R.state==='joining') fail('相手につながりませんでした。コードと電波状況を確認してください'); },15000);
  peer.on('open',()=>{
    if(R.peer!==peer) return;
    const conn=peer.connect(PEER_PREFIX+code,{reliable:true});
    setupConn(conn);
  });
  peer.on('error',e=>{ if(R.peer!==peer) return; if(R.state==='joining') fail(peerErrorText(e)); });
  peer.on('disconnected',()=>{ if(R.peer===peer&&!peer.destroyed){ try{ peer.reconnect(); }catch(err){} } });
}
function setupConn(conn){
  R.conn=conn; R.lastRecv=Date.now();
  conn.on('open',()=>{
    if(R.conn!==conn) return;
    clearTimeout(R.joinTimer); R.joinTimer=null;
    R.connected=true; R.lastRecv=Date.now();
    R.state='playing'; pushPresence();
    clearInterval(R.hb);
    R.hb=setInterval(()=>{
      if(R.conn!==conn) return;
      try{ if(conn.open) conn.send({t:'ping'}); }catch(e){}
      if(Date.now()-R.lastRecv>20000) onLost('接続が切れました');
    },4000);
    if(!R.opp) render();
    syncOnline();
  });
  conn.on('data',d=>{
    if(R.conn!==conn||!d||typeof d!=='object') return;
    R.lastRecv=Date.now();
    if(d.t==='full'){ destroyPeer(); resetMatch(); R.state='menu'; R.error='その部屋はすでに2人そろっています'; S.screen='online'; render(); return; }
    if(d.t==='state'){
      if(d.seat!==1-R.seat) return;
      R.opp={game:num(d.game,1), picks:Array.isArray(d.picks)?d.picks.slice(0,300):[]};
      syncOnline();
    }
  });
  conn.on('close',()=>{ if(R.conn===conn) onLost('相手が退出しました'); });
  conn.on('error',()=>{ if(R.conn===conn) onLost('接続が切れました'); });
}
function onLost(msg){
  if(S.screen==='left') return;
  stopTimer(); clearInterval(R.autoNext); R.autoNext=null; clearInterval(R.hb); R.hb=null;
  if(R.state==='joining'){ destroyPeer(); R.state='menu'; R.error=msg; render(); return; }
  destroyPeer();
  R.leftMsg=msg; S.screen='left'; render();
}
function leaveOnline(){ stopTimer(); destroyPeer(); resetMatch(); R.state='menu'; }
function syncOnline(){
  if(S.mode!=='online'||S.screen==='left'||R.state!=='playing'||!R.opp) return;
  const tg=R.opp.game;
  if(tg>R.game){ R.rematchOffered=true; if(S.screen==='result'||S.screen==='recap') render(); return; }
  if(tg<R.game){ R.waitingRematch=true; if(S.screen==='result') render(); return; }
  if(R.syncedGame!==R.game){
    R.syncedGame=R.game; R.ack=0; R.setPhase=0; R.rematchOffered=false; R.waitingRematch=false;
    clearInterval(R.autoNext); R.autoNext=null;
    S.hist=[]; S.date=new Date();
  }
  const mine=decList(R.picks), theirs=decList(R.opp.picks);
  const p0=R.seat===0?mine:theirs, p1=R.seat===0?theirs:mine;
  const rp=replay(p0,p1);
  const resolved=rp.phases.length;
  if(resolved>R.ack){
    if(!(S.screen==='result'&&S.phase===R.ack+1)) showOnlineResult(rp.phases[R.ack],R.ack+1,rp.phases);
    return;
  }
  if(rp.over!==undefined) return;
  const next=R.ack+1;
  if(mine.length>=next){
    if(S.screen!=='wait'){ stopTimer(); S.phase=next; S.life=rp.lives.slice(); S.screen='wait'; render(); }
    else render();
  }else{
    if(!(S.screen==='set'&&R.setPhase===next)){ R.setPhase=next; S.phase=next; S.life=rp.lives.slice(); S.prev=rp.lives.slice(); beginSet(R.seat); }
    else render();
  }
}
function showOnlineResult(ph,phaseNo,phases){
  stopTimer(); clearInterval(R.autoNext); R.autoNext=null;
  S.phase=phaseNo; S.prev=ph.before.slice(); S.life=ph.after.slice(); S.picks=ph.picks; S.result=ph.result; S.over=ph.over;
  S.hist=phases.slice(0,phaseNo).map(p=>({picks:[p.picks[0].slice(),p.picks[1].slice()], after:p.after.slice()})); S.resultDone=false;
  if(S.over!==undefined&&R.scoredGame!==R.game){ R.scoredGame=R.game; if(S.over===null) S.score[2]++; else S.score[S.over]++; }
  S.screen='result'; render(); animateResult();
  if(S.over===undefined){
    R.autoLeft=AUTO_NEXT;
    R.autoNext=setInterval(()=>{
      R.autoLeft--; const b=app.querySelector('[data-a="next"]'); if(b) b.textContent=`次のフェーズへ（あと${R.autoLeft}秒）`;
      if(R.autoLeft<=0) onlineNext();
    },1000);
  }
}
function onlineNext(){ clearInterval(R.autoNext); R.autoNext=null; R.ack++; syncOnline(); }
function onlineRematch(){
  const tg=R.opp?R.opp.game:R.game;
  if(tg>R.game){ R.game=tg; } else { R.game=R.game+1; R.waitingRematch=true; }
  R.picks=[]; R.rematchOffered=false; pushPresence(); render(); syncOnline();
}
function theirPicksLen(){ return R.opp?decList(R.opp.picks).length:0; }

/* ---------- views ---------- */
function hud(idx,animateFrom){
  const life=S.life[idx], from=animateFrom==null?life:animateFrom;
  const w=Math.max(0,Math.min(from,START))/START*100;
  return `<div class="hud c${idx+1}" data-hud="${idx}">
    <span class="who">${h(names()[idx])}</span>
    <div class="bar${from>START?' over':''}"><i style="width:${w}%"></i></div>
    <span class="num display">${from}<small>/99</small></span>
  </div>`;
}
function oppRow(done,label){
  return `<div class="opp${done?' done':''}">${MULT.map(m=>`<div><b class="display" style="color:var(--x${m})">×${m}</b><span class="display">${done?'?':'　'}</span></div>`).join('')}</div>
  ${label?`<div class="oppstat">${label}</div>`:''}`;
}
const connBadge = () => (S.mode==='online'&&R.state==='playing') ? `<span class="conn${R.connected?' on':''}">${R.connected?'接続中':'接続待ち…'}</span>` : '';
const topRight = () => `<span style="display:flex;gap:14px;align-items:center">${connBadge()}${S.mode==='online'?'<button data-a="title">退出</button>':''}<button data-a="rules">ルール</button></span>`;

