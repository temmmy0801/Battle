function vSet(locked){
  const me=S.cur, op=1-me, left=Math.max(0,S.deadline-Date.now());
  const full=!S.board.includes(null);
  const hint = locked ? '' : S.sel ? `${ITEMS[S.sel].e} をどの場に置く？` : full ? '配置をタップすると変更できます' : 'アイテムをタップしてから場をタップ';
  let oppDone=true, oppLabel='';
  if(S.mode==='online'){ oppDone=theirPicksLen()>=S.phase; oppLabel=oppDone?'相手は決定済み':'相手はセット中…'; }
  else if(S.mode==='local'){ oppDone=!!S.picks[op]; }
  const timer = locked ? `<div class="waiting"><span class="spin"></span>相手の決定を待っています</div>`
    : `<div class="timer${left<=10000?' low':''}"><div class="track"><i style="width:${left/LIMIT*100}%"></i></div><span class="sec display">${Math.ceil(left/1000)}秒</span></div>`;
  const foot = locked ? '' : `<div class="foot"><button class="btn p${me+1}" data-a="confirm" ${full?'':'disabled'}>この配置で決定</button></div>`;
  return `
  <div class="topbar"><span>フェーズ ${S.phase}</span>${topRight()}</div>
  ${hud(op)}
  ${oppRow(oppDone,oppLabel)}
  ${timer}
  <div class="board">${MULT.map((m,i)=>{
    const it=S.board[i];
    return `<button class="slot x${m}${S.sel&&!it?' target':''}${locked?' locked':''}" data-a="slot" data-v="${i}" aria-label="×${m}の場${it?'：'+ITEMS[it].n:''}">
      <span class="m display">×${m}</span>${it?ITEMS[it].e:''}${!it&&!S.sel?'<span class="tap">空</span>':''}</button>`;}).join('')}
  </div>
  ${locked?'':`<div class="tray">${ORDER.map(k=>`<button class="chip${S.sel===k?' sel':''}${S.board.includes(k)?' used':''}" data-a="pick" data-v="${k}" aria-label="${ITEMS[k].n}">${ITEMS[k].e}</button>`).join('')}</div>
  <div class="hintrow"><span class="hint">${hint}</span><button class="mini" data-a="shuffle">🎲 おまかせ</button></div>`}
  ${hud(me)}
  ${foot}`;
}

function vResult(){
  const r=S.result, bot=S.mode==='online'?R.seat:0, top=1-bot, done=S.resultDone;
  const fx=(list,slotIdx)=>`<div class="fx">${list.length?list.map((f,j)=>{
    const d=`style="animation-delay:${reduced?0:(0.5+slotIdx*0.4+j*0.12)}s"`;
    if(f.k==='dmg') return `<span class="dmg display" ${d}>−${f.v}</span>`;
    if(f.k==='heal') return `<span class="heal display" ${d}>+${f.v}</span>`;
    return `<span class="guard" ${d}>ガード</span>`;
  }).join(''):`<span class="none">—</span>`}</div>`;
  const net=i=>{const v=S.life[i]-S.prev[i];return (v>0?'+':'')+v;};
  const side=i=>r.slots.map(s=>i===0?s.fa:s.fb);
  const fTop=side(top), fBot=side(bot);
  let foot;
  if(S.over===undefined){
    foot=`<div class="foot"><button class="btn" data-a="next">次のフェーズへ${S.mode==='online'?`（あと${R.autoLeft||AUTO_NEXT}秒）`:''}</button></div>`;
  }else{
    const w=S.over;
    let extra='';
    if(S.mode==='online'){
      extra = R.rematchOffered ? `<p style="color:var(--heal)">相手が再戦を希望しています</p>` : R.waitingRematch ? `<p>相手の返事を待っています…</p>` : '';
    }
    const again = S.mode==='online'
      ? `<button class="btn" data-a="rematch" ${R.waitingRematch?'disabled':''}>${R.rematchOffered?'再戦する':'もう一度'}</button>`
      : `<button class="btn" data-a="again">もう一度</button>`;
    foot=`<div class="verdict">
      <div class="big display ${w===null?'':'c'+(w+1)}">${w===null?'引き分け':h(names()[w])+'の勝ち'}</div>
      <p>${S.phase}フェーズ目で決着　${h(names()[0])} ${S.life[0]} ／ ${h(names()[1])} ${S.life[1]}${(S.life[0]<=0&&S.life[1]<=0&&w!==null)?'<br>同時に0以下 → マイナスが大きい方の負け':''}</p>
      ${extra}
    </div>
    <div class="foot"><button class="btn secondary" data-a="recap" style="margin-bottom:10px">振り返りを見る</button><div class="row"><button class="btn secondary" data-a="title">${S.mode==='online'?'退出':'タイトルへ'}</button>${again}</div></div>`;
  }
  return `
  <div class="topbar"><span>フェーズ ${S.phase} の結果</span>${topRight()}</div>
  ${hud(top,done?null:S.prev[top])}
  <div class="clash${done?' still':''}">${MULT.map((m,i)=>`<div class="col">
    <div class="tile x${m}" style="animation-delay:${reduced?0:i*0.15}s">${ITEMS[S.picks[top][i]].e}</div>
    ${fx(fTop[i],i)}
    <div class="mid display x${m}">×${m}</div>
    ${fx(fBot[i],i)}
    <div class="tile x${m}" style="animation-delay:${reduced?0:i*0.15}s">${ITEMS[S.picks[bot][i]].e}</div>
  </div>`).join('')}</div>
  ${hud(bot,done?null:S.prev[bot])}
  <div class="sum"><span>${h(names()[top])} <b>${net(top)}</b></span><span>${h(names()[bot])} <b>${net(bot)}</b></span></div>
  ${foot}`;
}

function vLeft(){
  return `
  <div class="topbar"><span></span></div>
  <div class="center">
    <div class="big display">${h(R.leftMsg)}</div>
    <p>この対戦はここで終了です。</p>
  </div>
  <div class="foot">${S.hist.length?'<button class="btn secondary" data-a="recap" style="margin-bottom:10px">振り返りを見る</button>':''}<button class="btn" data-a="title">タイトルへ</button></div>`;
}

function buildRecap(){
  const me=S.mode==='online'?R.seat:0, them=1-me, nm=names();
  const rows=S.hist.map((p,i)=>({n:i+1, mine:p.picks[me], theirs:p.picks[them], lives:[p.after[me],p.after[them]]}));
  const last=S.hist[S.hist.length-1];
  const fin=last?[last.after[me],last.after[them]]:[START,START];
  const over=last?judge(last.after):undefined;
  let verdict, winner=null;
  if(over===undefined) verdict='途中終了'; else if(over===null) verdict='引き分け'; else { verdict=nm[over]+'の勝ち'; winner=over+1; }
  const d=S.date||new Date(), date=`${d.getFullYear()}/${d.getMonth()+1}/${d.getDate()}`;
  const mode=S.mode==='cpu'?`CPU対戦（${S.cpuLevel==='easy'?'ランダム':'読み合い'}）`:S.mode==='local'?'2人対戦':'オンライン対戦';
  const em=p=>p.map(k=>ITEMS[k].e).join('');
  const text=[`剣・盾・薬 バトル ${date} ${mode}`,`${nm[me]} vs ${nm[them]}`,
    ...rows.map(x=>`${x.n}フェーズ目 ${em(x.mine)} vs ${em(x.theirs)} ${x.lives[0]}-${x.lives[1]}`),
    `結果：${verdict}（${fin[0]}-${fin[1]}）`].join('\n');
  return {date,mode,me:{name:nm[me],c:me+1},them:{name:nm[them],c:them+1},rows,final:fin,verdict,winner,text};
}
function vRecap(){
  const r=S.lastRecap; if(!r) return vTitle();
  const em=p=>p.map(k=>ITEMS[k].e).join('');
  const lives=(a,b)=>`<span class="rl display"><b class="c${r.me.c}">${a}</b><span class="sep">-</span><b class="c${r.them.c}">${b}</b></span>`;
  const rows=r.rows.map(x=>`<div class="rrow"><span class="rn display">${x.n}</span><span class="rp">${em(x.mine)}</span><span class="rv">vs</span><span class="rp">${em(x.theirs)}</span>${lives(x.lives[0],x.lives[1])}</div>`).join('');
  const notice=(S.mode==='online'&&R.rematchOffered&&S.recapFrom==='result')?`<p class="note" style="color:var(--heal)">相手が再戦を希望しています（戻ると受けられます）</p>`:'';
  return `
  <div class="topbar"><button data-a="recapBack">← 戻る</button>${connBadge()}</div>
  <div class="recap">
    <div class="rtitle display">剣・盾・薬</div>
    <div class="rmeta">${h(r.date)}　${h(r.mode)}</div>
    <div class="rvs"><span class="pill c${r.me.c}">${h(r.me.name)}</span>vs<span class="pill c${r.them.c}">${h(r.them.name)}</span></div>
    <div class="rverdict display${r.winner?' c'+r.winner:''}">${h(r.verdict)}</div>
    <div class="rhdr"><span></span><span>×3×2×1</span><span></span><span>×3×2×1</span><span>ライフ</span></div>
    ${rows||'<p class="note" style="padding:10px 0">まだフェーズがありません</p>'}
    <div class="rfinal"><span>${r.rows.length}フェーズで終了</span>${lives(r.final[0],r.final[1])}</div>
  </div>
  ${notice}
  <div class="row"><button class="btn secondary" data-a="copyRecap">テキストをコピー</button>${navigator.share?'<button class="btn secondary" data-a="shareRecap">共有</button>':''}</div>
  <p class="note">この画面をスクショして保存できます</p>
  <div style="height:12px"></div>`;
}
let toastTimer=null;
function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(toastTimer); toastTimer=setTimeout(()=>t.classList.remove('show'),1600); }
async function copyText(t){
  try{ await navigator.clipboard.writeText(t); toast('コピーしました'); return; }catch(e){}
  try{ const ta=document.createElement('textarea'); ta.value=t; ta.setAttribute('readonly',''); ta.style.position='fixed'; ta.style.opacity='0'; document.body.appendChild(ta); ta.select(); const ok=document.execCommand('copy'); ta.remove(); toast(ok?'コピーしました':'コピーできませんでした'); }catch(e){ toast('コピーできませんでした'); }
}
let lastScreen=null;
function render(){
  const v={title:vTitle,online:vOnline,handoff:vHandoff,set:()=>vSet(false),wait:()=>vSet(true),result:vResult,left:vLeft,recap:vRecap}[S.screen];
  app.innerHTML=v();
  if(S.screen!==lastScreen){ window.scrollTo(0,0); lastScreen=S.screen; }
}

function animateResult(){
  const delay=reduced?0:1700, dur=reduced?0:700;
  setTimeout(()=>{
    if(S.screen!=='result') return;
    S.resultDone=true;
    app.querySelectorAll('.hud').forEach(el=>{
      const idx=+el.dataset.hud, to=S.life[idx], from=S.prev[idx];
      const bar=el.querySelector('.bar'), numEl=el.querySelector('.num');
      bar.classList.toggle('over',to>START);
      bar.querySelector('i').style.width=(Math.max(0,Math.min(to,START))/START*100)+'%';
      if(to<from) numEl.classList.add('hurt'); else if(to>from) numEl.classList.add('gain');
      const t0=performance.now();
      const step=now=>{
        const p=dur?Math.min(1,(now-t0)/dur):1, e=1-Math.pow(1-p,3);
        numEl.innerHTML=Math.round(from+(to-from)*e)+'<small>/99</small>';
        if(p<1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  },delay);
}

/* ---------- actions ---------- */
const A={
  start(v){ if(S.mode==='online') leaveOnline(); if(v!==S.mode) S.score=[0,0,0]; S.mode=v; startGame(); },
  online(){ if(S.mode!=='online') S.score=[0,0,0]; openOnline(); },
  host(){ hostRoom(); },
  join(){ joinRoom(); },
  cancelOnline(){ leaveOnline(); S.screen='online'; render(); },
  level(v){ S.cpuLevel=v; render(); },
  rules(){ rulesDlg.showModal(); },
  title(){ stopTimer(); if(S.hist.length) S.lastRecap=buildRecap(); if(S.mode==='online') leaveOnline(); S.screen='title'; render(); },
  recap(){ S.lastRecap=buildRecap(); S.recapFrom=S.screen; S.screen='recap'; render(); },
  recapLast(){ S.recapFrom='title'; S.screen='recap'; render(); },
  recapBack(){ S.screen=S.recapFrom||'title'; render(); },
  copyRecap(){ if(S.lastRecap) copyText(S.lastRecap.text); },
  shareRecap(){ if(S.lastRecap&&navigator.share) navigator.share({text:S.lastRecap.text}).catch(()=>{}); },
  begin(){ beginSet(S.cur); },
  again(){ startGame(); },
  rematch(){ onlineRematch(); },
  pick(v){ if(S.screen!=='set'||S.board.includes(v)) return; S.sel = S.sel===v ? null : v; render(); },
  slot(v){
    if(S.screen!=='set') return;
    const i=+v, it=S.board[i];
    if(S.sel){ S.board[i]=S.sel; S.sel=null; }
    else if(it){ S.board[i]=null; S.sel=it; }
    render();
  },
  shuffle(){ if(S.screen!=='set') return; S.board=shuffle(ORDER); S.sel=null; render(); },
  confirm(){ if(S.screen==='set') confirmSet(); },
  next(){ if(S.mode==='online') onlineNext(); else nextPhase(); }
};
app.addEventListener('click',e=>{
  const el=e.target.closest('[data-a]'); if(!el||el.disabled) return;
  const fn=A[el.dataset.a]; if(fn) fn(el.dataset.v,el);
});
app.addEventListener('input',e=>{ if(e.target.id==='code') R.codeInput=e.target.value; });
app.addEventListener('keydown',e=>{ if(e.target.id==='code'&&e.key==='Enter') joinRoom(); });

render();
})();
</script>
